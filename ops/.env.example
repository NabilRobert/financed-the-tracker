# Copy to ops/.env and chmod 600. docker compose reads ops/.env by itself, so cron's empty
# environment gets the same values as the deploy shell. ops/.env is never committed.
TRACKER_VERSION=<the deployed commit: the deploy step rewrites this line>
TRACKER_NETWORK_SUBNET=<a free /24 that no other Docker network on the server uses>
WAHA_API_KEY_SHA512=<sha512: then the hex SHA-512 of WAHA's API key>
WAHA_UNUSED_PANEL_PASSWORD=<a random value nobody uses>
